# ---------------------------------------------------------------------------
#  DPT.Server / NFS World - repository ignore rules
# ---------------------------------------------------------------------------

# old research material (huge, not ours to publish)
refs/
_refs/
__refs/

# build output
bin/
obj/
*.exe
*.pdb
*.dll
*.pfx
*.snk
*.ilk
*.cache
*.log
*.rsp

# runtime state: accounts, cars, sessions, generated config, certs
data/state/
data/certs/*
config.ini
logs/
launcher/launcher.ini
*.tmp
*.bak

# the default self signed EA-Chat certificate ships with the repo
!data/certs/xmpp.pfx
!data/certs/xmpp.cer

# the WebView2 SDK the launcher references is fetched by tools\fetch-webview2.ps1
# and must be present for a plain build.cmd on a fresh clone
!lib/webview2/*.dll

# keep the shipped web data, never ignore it
!data/profiles/**/*.xml
!data/profiles/**/*.json
!data/profiles/**/*.html
!data/profiles/**/*.png
!data/profiles/**/*.jpg

# editor / OS noise
.vs/
.vscode/
.idea/
*.user
*.suo
Thumbs.db
desktop.ini
.DS_Store

# local scratch
tmp/
scratch/
*.7z
*.zip